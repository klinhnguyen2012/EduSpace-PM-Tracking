# Project URL: Supabase Dashboard → Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) is safe for frontend use with RLS enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Older projects may only show the anon key (eyJ...). The app accepts this too.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
